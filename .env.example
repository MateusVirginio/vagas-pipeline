# Copie para .env e preencha somente no arquivo local.
# Neon: use a URL fornecida pelo painel, com sslmode=require.
# Docker local: postgresql://vagas:vagas@localhost:5432/vagas?sslmode=disable
WAREHOUSE_DATABASE_URL=

# Necessária apenas para gerar embeddings; diagnóstico e limpeza não usam a API.
OPENAI_API_KEY=

# Opcional: habilita os testes de integração com PostgreSQL.
# Prefira uma base local destinada aos testes.
TEST_DATABASE_URL=

# O dashboard lê DATABASE_URL em streamlit/.streamlit/secrets.toml,
# separadamente deste arquivo. Veja as instruções no README.
